{
    "schema_version": 1,
    "quilt_loader": {
        "group": "${group}",
        "id": "${mod_id}",
        "version": "${version}",
        "intermediate_mappings": "net.fabricmc:intermediary",
        "minecraft": {
            "environment": "*"
        },
        "metadata": {
            "name": "${mod_name}",
            "description": "${description}",
            "contributors": {
                "${mod_author}": "Developer"
            },
            "license": "${license}",
            "icon": "assets/inworldgamerules/icon.png"
        }
    },
    "mixin": [
        "inworldgamerules.mixins.json",
        "inworldgamerules.fabric.mixins.json"
    ]
}
